---
import YouTubeVideo from './YouTubeVideo.astro';
import type { SiteVideo } from '../data/videos';

interface Props {
  video: SiteVideo;
  heading: string;
  body: string;
}

const { video, heading, body } = Astro.props;
const headingId = `service-video-${video.id.replace(/[^a-z0-9]/gi, '')}`;
---
<section class="service-video-feature" aria-labelledby={headingId}>
  <div class="service-video-feature__copy">
    <p class="eyebrow">Inside KM Wellness · {video.durationLabel}</p>
    <h2 id={headingId}>{heading}</h2>
    <p>{body}</p>
    <a class="text-link" href={video.watchPath}>Open the full watch page</a>
  </div>

  <YouTubeVideo
    class="service-video-feature__player"
    videoId={video.id}
    title={video.title}
    durationLabel={video.durationLabel}
  />
</section>

<style>
  .service-video-feature {
    display: grid;
    grid-template-columns: minmax(220px, 0.72fr) minmax(0, 1.28fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3.25rem);
  }

  .service-video-feature__copy {
    position: relative;
    z-index: 1;
  }

  .service-video-feature__copy p:not(.eyebrow) {
    max-width: 32rem;
    margin-bottom: 1.25rem;
  }

  .service-video-feature__copy .text-link {
    color: var(--white);
  }

  .service-video-feature__copy .text-link::after {
    background: currentColor;
  }

  .service-video-feature :global(.service-video-feature__player) {
    position: relative;
    z-index: 1;
  }

  @media (max-width: 820px) {
    .service-video-feature {
      grid-template-columns: 1fr;
    }

    .service-video-feature__copy {
      max-width: 40rem;
    }
  }
</style>
