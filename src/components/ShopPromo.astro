---
import ExternalLinkIcon from './ExternalLinkIcon.astro';
import { shop } from '../config/site';

const products = [
  {
    name: 'Black Movement Is Medicine graphic T-shirt',
    image:
      'https://images-api.printify.com/mockup/6a831d348ae90ddd3b0ef273/73204/98445/movement-is-medicine.jpg?camera_label=front&revision=1787750299680',
  },
  {
    name: 'Black KM Wellness logo T-shirt',
    image:
      'https://images-api.printify.com/mockup/6a830e729876a5dd27073fdd/73204/98445/movement-is-medicine.jpg?camera_label=front&revision=1787752116320',
  },
] as const;
---

<section class="shop-promo" aria-labelledby="shop-promo-title">
  <div class="shop-promo-copy">
    <p class="eyebrow">KM Wellness Shop</p>
    <h2 id="shop-promo-title">Movement is medicine.</h2>
    <p>Carry the message beyond the clinic with official KM Wellness apparel.</p>
    <a
      class="button shop-promo-link"
      href={shop.url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Shop KM Wellness merchandise (opens in a new tab)"
    >
      Shop merchandise
      <ExternalLinkIcon />
    </a>
  </div>

  <a
    class="shop-promo-products"
    href={shop.url}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Browse the KM Wellness merchandise collection (opens in a new tab)"
  >
    {products.map((product) => (
      <img
        src={product.image}
        alt={product.name}
        width="1200"
        height="1200"
        loading="lazy"
        decoding="async"
        referrerpolicy="no-referrer"
      />
    ))}
    <span class="shop-promo-badge" aria-hidden="true">
      Visit the shop <ExternalLinkIcon />
    </span>
  </a>
</section>

<style>
  .shop-promo {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(360px, 0.72fr);
    min-height: 250px;
    overflow: hidden;
    border: 1px solid #2f2f2f;
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 15% 120%, rgb(255 255 255 / 11%), transparent 20rem),
      linear-gradient(135deg, #050505, #191919 68%, #090909);
    color: var(--white);
    box-shadow: 0 16px 44px rgb(0 0 0 / 12%);
  }

  .shop-promo-copy {
    align-self: center;
    padding: clamp(1.6rem, 4vw, 2.75rem);
  }

  .shop-promo .eyebrow {
    color: #b8b8b8;
  }

  .shop-promo h2 {
    max-width: 500px;
    margin-bottom: 0.65rem;
    color: var(--white);
    font-size: clamp(2rem, 4vw, 3.6rem);
  }

  .shop-promo-copy > p:not(.eyebrow) {
    max-width: 440px;
    margin-bottom: 1.1rem;
    color: rgb(255 255 255 / 74%);
    font-size: var(--text-body);
  }

  .shop-promo-link {
    border-color: var(--white);
    background: var(--white);
    color: var(--black);
  }

  .shop-promo-link:hover,
  .shop-promo-link:focus-visible {
    border-color: #d4d4d4;
    background: #d4d4d4;
    color: var(--black);
  }

  .shop-promo-products {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    min-width: 0;
    overflow: hidden;
    border-left: 1px solid #2f2f2f;
    background: #f4f4f4;
  }

  .shop-promo-products::after {
    position: absolute;
    inset: 0;
    content: "";
    pointer-events: none;
    box-shadow: inset 14px 0 28px rgb(0 0 0 / 11%);
  }

  .shop-promo-products img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 250px;
    object-fit: cover;
    transition: transform 240ms ease;
  }

  .shop-promo-products img + img {
    border-left: 1px solid #d4d4d4;
  }

  .shop-promo-products:hover img,
  .shop-promo-products:focus-visible img {
    transform: scale(1.025);
  }

  .shop-promo-products:focus-visible {
    outline: 3px solid var(--white);
    outline-offset: -5px;
  }

  .shop-promo-badge {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    padding: 0.65rem 0.8rem;
    border: 1px solid rgb(255 255 255 / 28%);
    border-radius: 999px;
    background: rgb(0 0 0 / 82%);
    color: var(--white);
    font-size: var(--text-xs);
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    backdrop-filter: blur(8px);
  }

  @media (max-width: 760px) {
    .shop-promo {
      grid-template-columns: 1fr;
    }

    .shop-promo-products {
      min-height: 210px;
      border-top: 1px solid #2f2f2f;
      border-left: 0;
    }

    .shop-promo-products::after {
      box-shadow: inset 0 14px 28px rgb(0 0 0 / 10%);
    }

    .shop-promo-products img {
      min-height: 210px;
    }
  }

  @media (max-width: 430px) {
    .shop-promo-products {
      min-height: 175px;
    }

    .shop-promo-products img {
      min-height: 175px;
    }
  }
</style>
