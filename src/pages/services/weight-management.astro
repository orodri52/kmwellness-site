---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from "../../components/LeadForm.astro";
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedServices from '../../components/RelatedServices.astro';
import groupTrainingPhoto from '../../assets/images/weight-management-group-training.jpg';

const seo = {
  title: 'Weight Management Clinic in El Paso, TX | KM Wellness Center',
  description:
    'A weight management clinic in El Paso combining nutrition counseling, fitness coaching, and medical care coordinated with Kingsway Medical Center — built around your goals, not a single prescription.',
};
---
<BaseLayout {...seo}>
  <Breadcrumbs crumbs={[{ name: 'Home', href: '/' }, { name: 'Services', href: '/services/' }, { name: 'Weight Management', href: '/services/weight-management/' }]} />
  <h1>Weight Management Clinic in El Paso</h1>

  <p>
    Struggling with weight can affect more than your appearance &mdash; it can impact your energy,
    confidence, and overall health. At KM Wellness Center, weight management isn't handled by a single
    provider working alone. It's a coordinated program across nutrition, fitness, and medical care, built
    around your specific goals.
  </p>

  <Image
    class="feature-photo"
    src={groupTrainingPhoto}
    alt="Trainer coaching clients during a weight management session at KM Wellness Center in El Paso"
    widths={[430, 860, 1290]}
    sizes="(min-width: 900px) 860px, 100vw"
    format="webp"
    quality={75}
    loading="lazy"
    decoding="async"
  />

  <section>
    <h2>Your Weight Management Team</h2>
    <ul>
      <li><strong>Nutrition:</strong> Daniel Chavez, RD, LD, CSCS, provides nutrition counseling, body composition analysis, and metabolic testing.</li>
      <li><strong>Fitness:</strong> Brenda Alvarez, MS, Lead Kinesiologist, and Aaron Vazquez, BS, Certified Personal Trainer, build and supervise your exercise programming &mdash; see our <a href="/personal-training/">personal training</a> page for details.</li>
      <li><strong>Medical care:</strong> When medication or a medical evaluation is appropriate, care is coordinated with <a href="https://kingswaymedical.com/" target="_blank" rel="noopener noreferrer">Kingsway Medical Center</a>'s Board-Certified Family Nurse Practitioners and Medical Doctor. See our <a href="/services/weight-loss-prescription-disease-management/">weight loss prescription &amp; disease management</a> and <a href="/services/glp-1-weight-loss-el-paso/">GLP-1 weight loss counseling</a> pages for medication-specific details.</li>
    </ul>
  </section>

  <section>
    <h2>What's Included</h2>
    <p>
      Depending on your plan, your program may include nutrition counseling, body composition analysis,
      Resting Metabolic Rate (RMR) testing, lab review, exercise programming, and behavioral/lifestyle
      counseling. Follow-up visits are typically every 2&ndash;4 weeks at the start, becoming less frequent
      as habits become established, and are available in person or via telehealth.
    </p>
  </section>

  <section>
    <h2>How Long Does It Take?</h2>
    <p>
      This varies by individual starting point and goals. Most patients participate for 3 to 12 months,
      and many continue with periodic maintenance visits afterward. We won't promise a specific outcome or
      timeline &mdash; your plan is built around your own progress, with objective measurements (not just
      the scale) used to track it.
    </p>
    <p><a href="/contact-us/">Make an appointment</a></p>
  </section>

  <RelatedServices current="/services/weight-management/" />

  <LeadForm source="weight-management" service="Weight Loss Program" />
</BaseLayout>
