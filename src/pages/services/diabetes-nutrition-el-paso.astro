---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/LeadForm.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqSchema from '../../components/FaqSchema.astro';
import RelatedServices from '../../components/RelatedServices.astro';
import educationPhoto from '../../assets/images/medical-nutrition-education.jpg';

const seo = {
  title: 'Diabetes Nutrition in El Paso, TX | KM Wellness Center',
  description:
    'Medical nutrition therapy for Type 1 diabetes, Type 2 diabetes, prediabetes, and gestational diabetes in El Paso, from Daniel Chavez, RD, LD, CSCS at KM Wellness Center.',
};

const faqs = [
  {
    question: 'What kind of diabetes does KM Wellness Center help with?',
    answer:
      'We provide medical nutrition therapy and nutrition counseling for Type 1 diabetes, Type 2 diabetes, prediabetes, and gestational diabetes.',
  },
  {
    question: 'Is telehealth available for diabetes nutrition counseling?',
    answer:
      'Yes, appointments are available both in person and via telehealth, when clinically appropriate.',
  },
  {
    question: 'What does a diabetes nutrition visit cost without insurance?',
    answer:
      'Self-pay pricing is $150 for an initial nutrition assessment and $130 for follow-up visits. Coverage varies by insurance plan — our team can help verify your benefits before you begin care.',
  },
];
---
<BaseLayout {...seo}>
  <FaqSchema slot="head" items={faqs} />
  <Breadcrumbs crumbs={[{ name: 'Home', href: '/' }, { name: 'Services', href: '/services/' }, { name: 'Diabetes Nutrition', href: '/services/diabetes-nutrition-el-paso/' }]} />
  <h1>Diabetes Nutrition in El Paso, TX</h1>

  <p>
    Daniel Chavez, RD, LD, CSCS, provides medical nutrition therapy for patients with
    <strong>Type 1 diabetes, Type 2 diabetes, prediabetes, and gestational diabetes</strong>. Nutrition
    counseling is a core part of managing blood sugar alongside your medical care &mdash; not a
    replacement for it.
  </p>

  <Image
    class="feature-photo"
    src={educationPhoto}
    alt="Daniel Chavez, RD, reviewing a nutrition plan with clients at KM Wellness Center in El Paso"
    widths={[420, 640, 860]}
    sizes="(min-width: 900px) 860px, 100vw"
    format="webp"
    quality={75}
    loading="lazy"
    decoding="async"
  />

  <section>
    <h2>What's Included</h2>
    <p>
      Diabetes nutrition counseling may include a review of your current labs, individualized meal
      planning, blood sugar-focused education, and behavioral and lifestyle counseling. Follow-up
      appointments are available in person or via telehealth, and are scheduled based on your specific
      needs and goals.
    </p>
    <p>
      If weight management is also part of your care plan, see our
      <a href="/services/weight-loss-prescription-disease-management/">weight loss prescription &amp; disease management</a>
      and <a href="/services/glp-1-weight-loss-el-paso/">GLP-1 weight loss counseling</a> pages.
    </p>
  </section>

  <section>
    <h2>Cost</h2>
    <p>
      Self-pay pricing: <strong>$150</strong> for an initial nutrition assessment, <strong>$130</strong> for
      follow-up visits. Coverage varies by insurance plan &mdash; our team can help verify your benefits
      before you begin care.
    </p>
    <p><a href="/contact-us/">Make an appointment</a></p>
  </section>

  <section>
    <h2>Frequently Asked Questions</h2>
    {faqs.map((f) => (
      <details>
        <summary>{f.question}</summary>
        <p>{f.answer}</p>
      </details>
    ))}
  </section>

  <RelatedServices current="/services/diabetes-nutrition-el-paso/" />

  <LeadForm source="diabetes-nutrition" service="Nutrition Counseling" />
</BaseLayout>

<style>
  .feature-photo { width: 100%; height: auto; border-radius: var(--radius-lg, 12px); margin: 1.5rem 0; }
</style>
