---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/LeadForm.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqSchema from '../../components/FaqSchema.astro';
import RelatedServices from '../../components/RelatedServices.astro';
import consultPhoto from '../../assets/images/nutrition-counseling-consult.jpg';

const seo = {
  title: 'Sports Nutrition in El Paso, TX | KM Wellness Center',
  description:
    'Sports nutrition coaching in El Paso from Daniel Chavez, RD, LD, CSCS, CISSN — a Registered Dietitian and Certified Sports Nutritionist.',
};

const faqs = [
  {
    question: 'What makes KM Wellness Center different for sports nutrition?',
    answer:
      'Daniel Chavez holds both RD (Registered Dietitian) and CISSN (Certified Sports Nutritionist) credentials, along with CSCS (Certified Strength & Conditioning Specialist) — combining clinical nutrition training with sports-performance-specific expertise.',
  },
  {
    question: 'Does insurance cover sports nutrition counseling?',
    answer:
      'Coverage varies by plan. Our team will help verify your specific benefits and explain your options before you begin care.',
  },
];
---
<BaseLayout {...seo}>
  <FaqSchema slot="head" items={faqs} />
  <Breadcrumbs crumbs={[{ name: 'Home', href: '/' }, { name: 'Services', href: '/services/' }, { name: 'Sports Nutrition', href: '/services/sports-nutrition-el-paso/' }]} />
  <h1>Sports Nutrition in El Paso, TX</h1>

  <p>
    Daniel Chavez is a Registered &amp; Licensed Dietitian (RD, LD), a Certified Strength &amp;
    Conditioning Specialist (CSCS), and a <strong>Certified Sports Nutritionist (CISSN)</strong> &mdash;
    a combination that pairs clinical nutrition training with sports-performance-specific expertise for
    muscle building, athletic performance, and recovery.
  </p>

  <Image
    class="feature-photo"
    src={consultPhoto}
    alt="Daniel Chavez, RD, CISSN, providing nutrition counseling at KM Wellness Center in El Paso"
    widths={[420, 640, 860]}
    sizes="(min-width: 900px) 860px, 100vw"
    format="webp"
    quality={75}
    loading="lazy"
    decoding="async"
  />

  <section>
    <h2>Who This Is For</h2>
    <p>
      Sports nutrition counseling is available to anyone working on muscle building, athletic performance,
      or general sports nutrition goals. If your goals overlap with strength training, our
      <a href="/personal-training/">personal training</a> team &mdash; led by Brenda Alvarez, MS, Lead
      Kinesiologist &mdash; coordinates directly with Daniel on programming.
    </p>
  </section>

  <section>
    <h2>Cost</h2>
    <p>
      Self-pay pricing: <strong>$150</strong> for an initial nutrition assessment, <strong>$130</strong> for
      follow-up visits. Coverage varies by insurance plan &mdash; our team can help verify your benefits
      before you begin care.
    </p>
    <p><a href="/contact-us/">Make an appointment</a></p>
  </section>

  <section>
    <h2>Frequently Asked Questions</h2>
    {faqs.map((f) => (
      <details>
        <summary>{f.question}</summary>
        <p>{f.answer}</p>
      </details>
    ))}
  </section>

  <RelatedServices current="/services/sports-nutrition-el-paso/" />

  <LeadForm source="sports-nutrition" service="Nutrition Counseling" />
</BaseLayout>

<style>
  .feature-photo { width: 100%; height: auto; border-radius: var(--radius-lg, 12px); margin: 1.5rem 0; }
</style>
