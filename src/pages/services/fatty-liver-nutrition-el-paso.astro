---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/LeadForm.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqSchema from '../../components/FaqSchema.astro';
import RelatedServices from '../../components/RelatedServices.astro';
import consultPhoto from '../../assets/images/nutrition-counseling-consult.jpg';

const seo = {
  title: 'Fatty Liver (NAFLD) Nutrition in El Paso, TX | KM Wellness Center',
  description:
    'Medical nutrition therapy for fatty liver disease (NAFLD/NASH) in El Paso, from Daniel Chavez, RD, LD, CSCS at KM Wellness Center.',
};

const faqs = [
  {
    question: 'Does KM Wellness Center treat fatty liver disease?',
    answer:
      'Daniel Chavez, RD, LD, CSCS, provides medical nutrition therapy for fatty liver disease (NAFLD/NASH) as part of our chronic disease management services.',
  },
  {
    question: 'Does insurance cover this?',
    answer:
      'Coverage varies by plan. Our team will help verify your specific benefits and explain your options before you begin care.',
  },
];
---
<BaseLayout {...seo}>
  <FaqSchema slot="head" items={faqs} />
  <Breadcrumbs crumbs={[{ name: 'Home', href: '/' }, { name: 'Services', href: '/services/' }, { name: 'Fatty Liver Nutrition', href: '/services/fatty-liver-nutrition-el-paso/' }]} />
  <h1>Fatty Liver (NAFLD) Nutrition in El Paso, TX</h1>

  <p>
    Daniel Chavez, RD, LD, CSCS, provides medical nutrition therapy for
    <strong>fatty liver disease (NAFLD/NASH)</strong> as part of our chronic disease management services,
    alongside related conditions like metabolic syndrome and high cholesterol.
  </p>

  <Image
    class="feature-photo"
    src={consultPhoto}
    alt="Daniel Chavez, RD, providing one-on-one nutrition counseling at KM Wellness Center in El Paso"
    widths={[420, 640, 860]}
    sizes="(min-width: 900px) 860px, 100vw"
    format="webp"
    quality={75}
    loading="lazy"
    decoding="async"
  />

  <section>
    <h2>Related Conditions We Support</h2>
    <p>
      Fatty liver disease is often connected to other metabolic conditions. See our
      <a href="/services/cholesterol-heart-health-nutrition-el-paso/">cholesterol &amp; heart health nutrition</a>
      and <a href="/services/diabetes-nutrition-el-paso/">diabetes nutrition</a> pages if those apply to
      your care as well.
    </p>
  </section>

  <section>
    <h2>Cost</h2>
    <p>
      Self-pay pricing: <strong>$150</strong> for an initial nutrition assessment, <strong>$130</strong> for
      follow-up visits. Coverage varies by insurance plan &mdash; our team can help verify your benefits
      before you begin care.
    </p>
    <p><a href="/contact-us/">Make an appointment</a></p>
  </section>

  <section>
    <h2>Frequently Asked Questions</h2>
    {faqs.map((f) => (
      <details>
        <summary>{f.question}</summary>
        <p>{f.answer}</p>
      </details>
    ))}
  </section>

  <RelatedServices current="/services/fatty-liver-nutrition-el-paso/" />

  <LeadForm source="fatty-liver-nutrition" service="Nutrition Counseling" />
</BaseLayout>

<style>
  .feature-photo { width: 100%; height: auto; border-radius: var(--radius-lg, 12px); margin: 1.5rem 0; }
</style>
