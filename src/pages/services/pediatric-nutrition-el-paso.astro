---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/LeadForm.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqSchema from '../../components/FaqSchema.astro';
import RelatedServices from '../../components/RelatedServices.astro';
import consultPhoto from '../../assets/images/nutrition-counseling-consult.jpg';

const seo = {
  title: 'Pediatric Nutrition in El Paso, TX | KM Wellness Center',
  description:
    'Pediatric nutrition counseling in El Paso for patients from birth through age 18, from Daniel Chavez, RD, LD, CSCS at KM Wellness Center.',
};

const faqs = [
  {
    question: 'What age range do you see for pediatric nutrition?',
    answer: 'We see pediatric patients from birth through 18 years of age.',
  },
  {
    question: 'What pediatric conditions does KM Wellness Center support?',
    answer:
      'Growth concerns, pediatric obesity, diabetes, food allergies, gastrointestinal disorders, picky eating, sports nutrition, and other pediatric medical conditions.',
  },
];
---
<BaseLayout {...seo}>
  <FaqSchema slot="head" items={faqs} />
  <Breadcrumbs crumbs={[{ name: 'Home', href: '/' }, { name: 'Services', href: '/services/' }, { name: 'Pediatric Nutrition', href: '/services/pediatric-nutrition-el-paso/' }]} />
  <h1>Pediatric Nutrition in El Paso, TX</h1>

  <p>
    Daniel Chavez, RD, LD, CSCS, provides nutrition therapy for pediatric patients from
    <strong>birth through 18 years of age</strong>, covering growth concerns, pediatric obesity, diabetes,
    food allergies, gastrointestinal disorders, picky eating, sports nutrition, and other pediatric medical
    conditions.
  </p>

  <Image
    class="feature-photo"
    src={consultPhoto}
    alt="Daniel Chavez, RD, providing nutrition counseling at KM Wellness Center in El Paso"
    widths={[420, 640, 860]}
    sizes="(min-width: 900px) 860px, 100vw"
    format="webp"
    quality={75}
    loading="lazy"
    decoding="async"
  />

  <section>
    <h2>Areas We Support</h2>
    <ul>
      <li>Growth concerns</li>
      <li>Pediatric obesity</li>
      <li>Diabetes</li>
      <li>Food allergies</li>
      <li>Gastrointestinal disorders</li>
      <li>Picky eating</li>
      <li>Sports nutrition</li>
    </ul>
  </section>

  <section>
    <h2>Cost</h2>
    <p>
      Self-pay pricing: <strong>$150</strong> for an initial nutrition assessment, <strong>$130</strong> for
      follow-up visits. Coverage varies by insurance plan &mdash; our team can help verify your benefits
      before you begin care.
    </p>
    <p><a href="/contact-us/">Make an appointment</a></p>
  </section>

  <section>
    <h2>Frequently Asked Questions</h2>
    {faqs.map((f) => (
      <details>
        <summary>{f.question}</summary>
        <p>{f.answer}</p>
      </details>
    ))}
  </section>

  <RelatedServices current="/services/pediatric-nutrition-el-paso/" />

  <LeadForm source="pediatric-nutrition" service="Nutrition Counseling" />
</BaseLayout>

<style>
  .feature-photo { width: 100%; height: auto; border-radius: var(--radius-lg, 12px); margin: 1.5rem 0; }
</style>
