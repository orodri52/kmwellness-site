---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from "../../components/LeadForm.astro";
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqSchema from '../../components/FaqSchema.astro';
import RelatedServices from '../../components/RelatedServices.astro';
import nutritionistPhoto from '../../assets/images/nutritionist-consult.jpg';

const seo = {
  title: 'Nutritionist in El Paso | Best Dietitian 2024 & 2025',
  description:
    'Looking for a trusted nutritionist in El Paso? Meet Daniel Chavez, RD — Best Dietitian in El Paso 2024 & 2025 — and our registered dietitian team.',
};

const faqs = [
  { question: 'What is nutrition counseling?', answer: 'Nutrition counseling is a structured process where a registered dietitian helps you improve food choices, manage health conditions, and create a sustainable lifestyle through personalized guidance.' },
  { question: 'Can nutrition counseling help control blood sugar levels?', answer: 'Yes. Medical nutrition therapy is highly effective for improving blood sugar levels and supporting individuals with diabetes or prediabetes.' },
  { question: 'How do I find a dietitian in El Paso, TX?', answer: 'Look for a registered and licensed professional who provides evidence-based services and works alongside a care team. KM Wellness Center offers comprehensive nutrition counseling in El Paso.' },
  { question: 'How much does nutrition counseling in El Paso cost?', answer: 'Cost can vary depending on the length of the session and your specific needs. Some insurance plans cover medical nutrition therapy for certain conditions such as diabetes or high blood pressure. Our team will review your benefits and explain pricing options before you begin care.' },
  { question: 'Is nutrition counseling only for weight loss?', answer: 'No. While weight loss is common, nutrition counseling also helps with heart health, medical conditions, digestive issues, hormone balance, and many other health conditions.' },
  { question: 'Do I need a referral to schedule nutrition counseling in El Paso?', answer: 'In most cases you do not need a referral to begin. However, some insurance plans may require one. Our team can help verify your benefits and guide you through the process.' },
];
---
<BaseLayout {...seo}>
  <FaqSchema slot="head" items={faqs} />
  <Breadcrumbs crumbs={[{ name: 'Home', href: '/' }, { name: 'Services', href: '/services/' }, { name: 'Our Nutritionist', href: '/services/nutritionist-el-paso/' }]} />
  <h1>Nutritionist in El Paso, TX</h1>

  <p>
    Choosing the right nutritionist in El Paso, TX matters — credentials and experience make the
    difference between generic diet advice and care that actually works. KM Wellness Center is led by
    a Registered and Licensed Dietitian recognized as Best Dietitian in El Paso (2024 & 2025). Here's
    what to know before you decide who to trust with your nutrition care.
  </p>

  <Image
    class="feature-photo"
    src={nutritionistPhoto}
    alt="Registered dietitian explaining a nutrition plan to clients at KM Wellness Center in El Paso"
    widths={[420, 640, 860]}
    sizes="(min-width: 900px) 860px, 100vw"
    format="webp"
    quality={75}
    loading="lazy"
    decoding="async"
  />

  <section>
    <h2>Meet Your Registered Dietitian</h2>
    <p>
      KM Wellness Center's nutrition care is led by Daniel Chavez, RD, LD, CSCS, CISSN — Co-Founder
      and Registered Dietitian. Daniel is currently the only Registered Dietitian providing medical
      nutrition therapy and nutrition counseling at KM Wellness Center. He holds a dietetics degree
      from the University of Alabama, where he graduated Summa Cum Laude, and is also an alumnus of
      the University of Texas at El Paso. He was named <strong>Best Dietitian in El Paso (2024 &
      2025)</strong> by El Paso Inc., and his work has been featured in Forbes Health, GQ, Men's
      Journal, Generation Iron, and T-Nation. Read more about Daniel on our
      <a href="/about-us/">About Us</a> page or connect with him on
      <a href="https://www.linkedin.com/in/daniel-chavez-rd-ld-cscs-cissn-880894149/" target="_blank" rel="noopener noreferrer">LinkedIn</a>.
    </p>
  </section>

  <section>
    <h2>How to Choose a Nutritionist in El Paso</h2>
    <p>
      Look for a registered and licensed professional who provides evidence-based services and works
      alongside a care team — not just someone offering generic diet tips. KM Wellness Center's
      registered dietitians meet that standard and collaborate with kinesiologists and certified
      personal trainers, so your nutrition plan works together with the rest of your care rather than
      in isolation.
    </p>
  </section>

  <section>
    <h2>Conditions &amp; Services We Support</h2>
    <p>
      Our registered dietitian provides medical nutrition therapy for diagnosed conditions such as
      <a href="/services/diabetes-nutrition-el-paso/">Type 1 and Type 2 diabetes</a>, high blood
      pressure, cardiovascular disease, and <a href="/services/pcos-nutrition-el-paso/">PCOS</a>, as
      well as everyday nutrition counseling for weight loss and sustainable healthy habits. Learn more
      about our <a href="/services/medical-nutrition/">medical nutrition therapy</a> or
      <a href="/services/medical-nutrition-therapy-and-nutrition-counseling/">nutrition counseling</a>
      services.
    </p>
  </section>

  <section>
    <h2>Why Choose Our Nutritionist in El Paso, TX?</h2>
    <ul>
      <li>Experienced registered dietitians</li>
      <li>Evidence-based nutrition therapy</li>
      <li>Personalized meal planning</li>
      <li>Collaboration with a full care team</li>
      <li>Holistic and medical integration</li>
      <li>Support for complex health conditions</li>
      <li>Focus on sustainable lifestyle changes</li>
    </ul>
  </section>

  <section>
    <h2>Frequently Asked Questions</h2>
    {faqs.map((f) => (
      <details>
        <summary>{f.question}</summary>
        <p>{f.answer}</p>
      </details>
    ))}
    <p><a href="/contact-us/">Make an appointment</a></p>
  </section>

  <RelatedServices current="/services/nutritionist-el-paso/" />

  <LeadForm source="nutritionist-el-paso" service="Nutrition Counseling" />
</BaseLayout>
