---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from "../../components/LeadForm.astro";
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqSchema from '../../components/FaqSchema.astro';
import RelatedServices from '../../components/RelatedServices.astro';
import prescriptionPhoto from '../../assets/images/weight-loss-prescription-consult.jpg';

const seo = {
  title: 'Weight Loss Prescription & Disease Management | KM Wellness Center | El Paso',
  description:
    'Medically supervised weight loss and chronic disease management in El Paso, coordinated with Kingsway Medical Center and paired with nutrition counseling from our Registered Dietitian.',
};

const faqs = [
  {
    question: 'Who provides the medical side of this program?',
    answer:
      'Medical weight management is provided in collaboration with Kingsway Medical Center, whose team includes Board-Certified Family Nurse Practitioners and a Medical Doctor. Daniel Chavez, RD, LD, CSCS, provides the nutrition counseling and lifestyle coaching alongside your medical care.',
  },
  {
    question: 'How often are follow-up visits?',
    answer:
      'Follow-up is individualized based on your condition and goals. Most patients are seen every 2-4 weeks initially, with visits becoming less frequent as healthy habits become established. Appointments are available in person or via telehealth.',
  },
  {
    question: 'What happens at a follow-up visit?',
    answer:
      'Depending on your plan, follow-ups may include progress review, nutrition counseling, goal adjustments, lab review, body composition review, metabolism retesting, exercise programming, behavioral and lifestyle counseling, meal planning refinement, and medication nutrition support when applicable.',
  },
  {
    question: 'How long do people typically stay in the program?',
    answer:
      'This varies by starting point and goals. Most patients participate for 3 to 12 months, and many continue with periodic maintenance visits afterward to support long-term results. We don’t promise a specific timeline or outcome — your plan is built around your own progress.',
  },
];
---
<BaseLayout {...seo}>
  <FaqSchema slot="head" items={faqs} />
  <Breadcrumbs crumbs={[{ name: 'Home', href: '/' }, { name: 'Services', href: '/services/' }, { name: 'Weight Loss Prescription & Disease Management', href: '/services/weight-loss-prescription-disease-management/' }]} />
  <h1>Weight Loss Prescription &amp; Disease Management</h1>

  <p>
    At KM Wellness Center, weight loss prescription and disease management is a coordinated program
    between two teams: the medical providers at
    <a href="https://kingswaymedical.com/" target="_blank" rel="noopener noreferrer">Kingsway Medical Center</a>
    &mdash; Board-Certified Family Nurse Practitioners and a Medical Doctor &mdash; who handle medical
    evaluation and prescribing, and our Registered &amp; Licensed Dietitian, Daniel Chavez, RD, LD, CSCS,
    who provides nutrition counseling, body composition analysis, metabolic testing, and lifestyle
    coaching. Looking specifically for GLP-1 medication (semaglutide/tirzepatide) information? See our
    <a href="/services/glp-1-weight-loss-el-paso/">GLP-1 weight loss counseling</a> page.
  </p>

  <Image
    class="feature-photo"
    src={prescriptionPhoto}
    alt="Provider reviewing a weight-loss treatment option with a client at KM Wellness Center in El Paso"
    widths={[420, 640, 860]}
    sizes="(min-width: 900px) 860px, 100vw"
    format="webp"
    quality={75}
    loading="lazy"
    decoding="async"
  />

  <section>
    <h2>Conditions We Help Manage</h2>
    <p>Alongside weight management, Daniel provides medical nutrition therapy and nutrition counseling for a range of conditions, including:</p>
    <ul>
      <li>Obesity and overweight</li>
      <li>Type 1, Type 2, and gestational diabetes; prediabetes</li>
      <li>Hypertension, hyperlipidemia, and high cholesterol</li>
      <li>Metabolic syndrome</li>
      <li>Fatty liver disease (NAFLD/NASH)</li>
      <li>Chronic kidney disease</li>
      <li>Heart disease</li>
    </ul>
    <p>
      For a closer look at how we support specific conditions, see our
      <a href="/services/diabetes-nutrition-el-paso/">diabetes nutrition</a>,
      <a href="/services/kidney-disease-nutrition-el-paso/">kidney disease nutrition</a>, and
      <a href="/services/cholesterol-heart-health-nutrition-el-paso/">cholesterol &amp; heart health nutrition</a>
      pages.
    </p>
  </section>

  <section>
    <h2>What Ongoing Care Looks Like</h2>
    <p>
      Follow-up is individualized based on your medical condition and goals. Most patients are seen every
      2&ndash;4 weeks initially, with visits becoming less frequent as healthy habits become established.
      Appointments are available in person or via telehealth. Depending on your plan, a follow-up visit may
      include:
    </p>
    <ul>
      <li>Progress review and SMART goal adjustments</li>
      <li>Nutrition counseling and meal planning refinement</li>
      <li>Lab review (through CPL or other laboratory partners)</li>
      <li>Body composition review and Resting Metabolic Rate (RMR) retesting</li>
      <li>Exercise programming</li>
      <li>Behavioral and lifestyle counseling</li>
      <li>Medication nutrition support, when applicable</li>
    </ul>
  </section>

  <section>
    <h2>How Long Does the Program Take?</h2>
    <p>
      This varies considerably depending on your starting point and goals. Most patients participate for
      3 to 12 months, and many continue with periodic maintenance visits afterward to support long-term
      results. We don't guarantee a specific outcome or timeline &mdash; your plan is built around your own
      progress.
    </p>
    <p><a href="/contact-us/">Make an appointment</a></p>
  </section>

  <section>
    <h2>Frequently Asked Questions</h2>
    {faqs.map((f) => (
      <details>
        <summary>{f.question}</summary>
        <p>{f.answer}</p>
      </details>
    ))}
  </section>

  <RelatedServices current="/services/weight-loss-prescription-disease-management/" />

  <LeadForm source="weight-loss-prescription" service="Weight Loss Program" />
</BaseLayout>
