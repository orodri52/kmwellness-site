---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/LeadForm.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqSchema from '../../components/FaqSchema.astro';
import RelatedServices from '../../components/RelatedServices.astro';
import consultPhoto from '../../assets/images/nutrition-counseling-consult.jpg';

const seo = {
  title: 'Digestive Health Nutrition in El Paso, TX | KM Wellness Center',
  description:
    'Medical nutrition therapy for IBS, Crohn’s disease, ulcerative colitis, celiac disease, GERD, and other digestive conditions in El Paso, from Daniel Chavez, RD, LD, CSCS.',
};

const faqs = [
  {
    question: 'What digestive conditions does KM Wellness Center help with?',
    answer:
      'We provide medical nutrition therapy for IBS, Crohn’s disease, ulcerative colitis, celiac disease, GERD, constipation, diarrhea, food intolerances, and general digestive health, including low-FODMAP nutrition therapy.',
  },
  {
    question: 'Does insurance cover digestive health nutrition counseling?',
    answer:
      'Coverage varies by plan. Our team will help verify your specific benefits and explain your options before you begin care.',
  },
];
---
<BaseLayout {...seo}>
  <FaqSchema slot="head" items={faqs} />
  <Breadcrumbs crumbs={[{ name: 'Home', href: '/' }, { name: 'Services', href: '/services/' }, { name: 'Digestive Health Nutrition', href: '/services/digestive-health-nutrition-el-paso/' }]} />
  <h1>Digestive Health Nutrition in El Paso, TX</h1>

  <p>
    Daniel Chavez, RD, LD, CSCS, provides medical nutrition therapy for digestive and gastrointestinal
    conditions, including <strong>IBS, Crohn's disease, ulcerative colitis, celiac disease, GERD,
    constipation, diarrhea, and food intolerances</strong> &mdash; including low-FODMAP nutrition therapy
    where appropriate.
  </p>

  <Image
    class="feature-photo"
    src={consultPhoto}
    alt="Daniel Chavez, RD, providing one-on-one nutrition counseling at KM Wellness Center in El Paso"
    widths={[420, 640, 860]}
    sizes="(min-width: 900px) 860px, 100vw"
    format="webp"
    quality={75}
    loading="lazy"
    decoding="async"
  />

  <section>
    <h2>Conditions We Support</h2>
    <ul>
      <li>Irritable bowel syndrome (IBS)</li>
      <li>Crohn's disease and ulcerative colitis</li>
      <li>Celiac disease</li>
      <li>GERD</li>
      <li>Constipation and diarrhea</li>
      <li>Food intolerances</li>
      <li>Low-FODMAP nutrition therapy</li>
      <li>General digestive health</li>
    </ul>
  </section>

  <section>
    <h2>Cost</h2>
    <p>
      Self-pay pricing: <strong>$150</strong> for an initial nutrition assessment, <strong>$130</strong> for
      follow-up visits. Coverage varies by insurance plan &mdash; our team can help verify your benefits
      before you begin care.
    </p>
    <p><a href="/contact-us/">Make an appointment</a></p>
  </section>

  <section>
    <h2>Frequently Asked Questions</h2>
    {faqs.map((f) => (
      <details>
        <summary>{f.question}</summary>
        <p>{f.answer}</p>
      </details>
    ))}
  </section>

  <RelatedServices current="/services/digestive-health-nutrition-el-paso/" />

  <LeadForm source="digestive-health-nutrition" service="Nutrition Counseling" />
</BaseLayout>

<style>
  .feature-photo { width: 100%; height: auto; border-radius: var(--radius-lg, 12px); margin: 1.5rem 0; }
</style>
