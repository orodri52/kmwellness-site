---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/LeadForm.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqSchema from '../../components/FaqSchema.astro';
import RelatedServices from '../../components/RelatedServices.astro';
import consultPhoto from '../../assets/images/nutrition-counseling-consult.jpg';

const seo = {
  title: "Women's Health Nutrition in El Paso, TX | KM Wellness Center",
  description:
    "Nutrition counseling for PCOS, fertility, pregnancy, postpartum, and menopause in El Paso, from Daniel Chavez, RD, LD, CSCS at KM Wellness Center.",
};

const faqs = [
  {
    question: "Does insurance cover women's health nutrition counseling?",
    answer:
      'Coverage varies by plan. Our team will help verify your specific benefits and explain your options before you begin care.',
  },
  {
    question: 'Is telehealth available?',
    answer:
      'Yes, appointments are available both in person and via telehealth, when clinically appropriate.',
  },
];
---
<BaseLayout {...seo}>
  <FaqSchema slot="head" items={faqs} />
  <Breadcrumbs crumbs={[{ name: 'Home', href: '/' }, { name: 'Services', href: '/services/' }, { name: "Women's Health Nutrition", href: '/services/womens-health-nutrition-el-paso/' }]} />
  <h1>Women's Health Nutrition in El Paso, TX</h1>

  <p>
    Daniel Chavez, RD, LD, CSCS, provides nutrition counseling for women at every stage of life, including
    <strong>PCOS, fertility optimization, pregnancy nutrition, gestational diabetes, postpartum nutrition,
    breastfeeding nutrition, menopause, and perimenopause</strong>.
  </p>

  <Image
    class="feature-photo"
    src={consultPhoto}
    alt="Daniel Chavez, RD, providing one-on-one nutrition counseling at KM Wellness Center in El Paso"
    widths={[420, 640, 860]}
    sizes="(min-width: 900px) 860px, 100vw"
    format="webp"
    quality={75}
    loading="lazy"
    decoding="async"
  />

  <section>
    <h2>Areas We Support</h2>
    <ul>
      <li>PCOS &mdash; see our dedicated <a href="/services/pcos-nutrition-el-paso/">PCOS nutrition</a> page</li>
      <li>Fertility optimization</li>
      <li>Pregnancy nutrition and gestational diabetes</li>
      <li>Postpartum and breastfeeding nutrition</li>
      <li>Menopause and perimenopause</li>
      <li>Healthy weight management throughout every stage of life</li>
    </ul>
  </section>

  <section>
    <h2>Cost</h2>
    <p>
      Self-pay pricing: <strong>$150</strong> for an initial nutrition assessment, <strong>$130</strong> for
      follow-up visits. Coverage varies by insurance plan &mdash; our team can help verify your benefits
      before you begin care.
    </p>
    <p><a href="/contact-us/">Make an appointment</a></p>
  </section>

  <section>
    <h2>Frequently Asked Questions</h2>
    {faqs.map((f) => (
      <details>
        <summary>{f.question}</summary>
        <p>{f.answer}</p>
      </details>
    ))}
  </section>

  <RelatedServices current="/services/womens-health-nutrition-el-paso/" />

  <LeadForm source="womens-health-nutrition" service="Nutrition Counseling" />
</BaseLayout>

<style>
  .feature-photo { width: 100%; height: auto; border-radius: var(--radius-lg, 12px); margin: 1.5rem 0; }
</style>
