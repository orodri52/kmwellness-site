---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import aetna from '../assets/images/insurance/aetna.png';
import alignmentHealth from '../assets/images/insurance/alignment-health.png';
import blueCrossBlueShield from '../assets/images/insurance/blue-cross-blue-shield.png';
import wellmed from '../assets/images/insurance/wellmed.png';
import cigna from '../assets/images/insurance/cigna.png';
import ambetter from '../assets/images/insurance/ambetter.jpg';
import humana from '../assets/images/insurance/humana.png';
import unitedhealthcare from '../assets/images/insurance/unitedhealthcare.png';
import medicare from '../assets/images/insurance/medicare-accepted.svg';
import molina from '../assets/images/insurance/molina.png';
import oscarHealth from '../assets/images/insurance/oscar-health.png';
import triwest from '../assets/images/insurance/triwest.png';

const seo = {
  title: 'Insurances We Accept | KM Wellness Center | El Paso, TX',
  description:
    'KM Wellness Center accepts most commercial, Marketplace, and Medicare plans, including Aetna, Ambetter, Blue Cross Blue Shield, Cigna, Humana, Molina, TriWest (TRICARE), and more.',
};

const insurers = [
  { name: 'Aetna', logo: aetna },
  { name: 'Alignment Health Plan', logo: alignmentHealth },
  { name: 'Ambetter Health', logo: ambetter },
  { name: 'Blue Cross Blue Shield', logo: blueCrossBlueShield },
  { name: 'Cigna', logo: cigna },
  { name: 'Humana', logo: humana },
  { name: 'Medicare', logo: medicare },
  { name: 'Molina Healthcare', logo: molina },
  { name: 'Oscar Health', logo: oscarHealth },
  { name: 'TriWest Healthcare Alliance (TRICARE)', logo: triwest },
  { name: 'UnitedHealthcare', logo: unitedhealthcare },
  { name: 'WellMed', logo: wellmed },
];

const faqs = [
  {
    question: 'What insurance plans does KM Wellness Center accept?',
    answer:
      'We accept most commercial, Marketplace, and Medicare insurance plans. Accepted plans include Aetna, Alignment Health Plan, Ambetter Health, Blue Cross Blue Shield, Cigna, Humana, Medicare, Molina Healthcare, Oscar Health, TriWest Healthcare Alliance (TRICARE), UnitedHealthcare, and WellMed.',
  },
  {
    question: 'Does KM Wellness Center accept Medicare plans?',
    answer:
      'Yes, we accept most Medicare plans. Coverage and benefits vary, so please contact us to verify your specific plan before beginning care.',
  },
  {
    question: 'Do you accept Marketplace and commercial insurance plans?',
    answer:
      'Yes, we accept most Marketplace and commercial insurance plans. Our team can confirm whether your specific policy covers the services you need.',
  },
  {
    question: 'How can I verify whether my insurance plan is covered?',
    answer:
      'Contact KM Wellness Center with your insurance information, and our team will help verify your benefits and explain your coverage before you begin care.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---
<BaseLayout {...seo}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />
  <Breadcrumbs crumbs={[{ name: 'Home', href: '/' }, { name: 'About', href: '/about-us/' }, { name: 'Insurances we Accept', href: '/insurances-we-accept/' }]} />
  <h1>Insurances We Accept</h1>
  <p>
    KM Wellness Center accepts most commercial, Marketplace, and Medicare insurance plans, including
    the providers below.
  </p>
  <div class="insurer-logo-section">
    <ul class="insurer-grid">
      {insurers.map((i) => (
        <li>
          {i.logo ? (
            <Image src={i.logo} alt={`${i.name} insurance accepted at KM Wellness Center`} height={120} format="webp" quality={80} loading="lazy" decoding="async" />
          ) : (
            <span class="insurer-name">{i.name}</span>
          )}
        </li>
      ))}
    </ul>
  </div>
  <p class="provider-note">
    This is not a complete list of accepted insurance plans.
  </p>
  <p>
    Coverage varies by plan. <a href="/contact-us/">Contact us</a> and we'll help verify your benefits
    before you begin care.
  </p>
  <section class="insurance-faq" aria-labelledby="insurance-faq-heading">
    <h2 id="insurance-faq-heading">Insurance FAQs</h2>
    {faqs.map((faq) => (
      <details>
        <summary>{faq.question}</summary>
        <p>{faq.answer}</p>
      </details>
    ))}
  </section>
</BaseLayout>

<style>
  .insurer-logo-section {
    width: min(100%, 960px);
    margin: 0 auto;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--support-dark-border);
    border-radius: var(--radius-lg);
    background: var(--support-dark-surface);
    box-shadow: 0 18px 48px rgb(0 0 0 / 14%);
  }
  .insurer-grid {
    list-style: none;
    width: 100%;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
    align-items: center;
  }
  .insurer-grid li {
    margin: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    flex: 0 0 210px;
    box-sizing: border-box;
    padding: 1rem;
    border-radius: var(--radius-md);
    background: var(--white);
  }
  .insurer-grid img {
    max-width: 100%;
    max-height: 60px;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .insurer-name {
    color: var(--black);
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.2;
    text-align: center;
  }
  .provider-note {
    text-align: center;
    font-weight: 700;
  }
  .insurance-faq {
    width: min(100%, 960px);
    margin-inline: auto;
  }
</style>
