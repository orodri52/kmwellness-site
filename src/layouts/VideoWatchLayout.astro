---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import VideoSchema from '../components/VideoSchema.astro';
import YouTubeVideo from '../components/YouTubeVideo.astro';
import type { SiteVideo } from '../data/videos';

interface Props {
  video: SiteVideo;
  seoTitle: string;
  seoDescription: string;
  serviceName: string;
  servicePath: string;
  intro: string;
  detailEyebrow: string;
  detailTitle: string;
  detailBody: string;
  ctaTitle: string;
  ctaBody: string;
}

const {
  video,
  seoTitle,
  seoDescription,
  serviceName,
  servicePath,
  intro,
  detailEyebrow,
  detailTitle,
  detailBody,
  ctaTitle,
  ctaBody,
} = Astro.props;
---
<BaseLayout title={seoTitle} description={seoDescription} image={video.thumbnailUrl}>
  <VideoSchema
    slot="head"
    name={video.title}
    description={video.description}
    thumbnailUrl={video.thumbnailUrl}
    uploadDate={video.uploadDate}
    duration={video.duration}
    embedUrl={video.embedUrl}
    isMainContent
  />
  <link slot="head" rel="preconnect" href="https://www.youtube-nocookie.com" />
  <link slot="head" rel="preconnect" href="https://i.ytimg.com" />

  <Breadcrumbs
    crumbs={[
      { name: 'Home', href: '/' },
      { name: serviceName, href: servicePath },
      { name: 'Watch', href: video.watchPath },
    ]}
  />

  <div class="watch-page">
    <header class="watch-intro">
      <div>
        <p class="eyebrow">KM Wellness video · {video.durationLabel}</p>
        <h1>{video.title}</h1>
      </div>
      <p>{intro}</p>
    </header>

    <div class="watch-player-shell">
      <YouTubeVideo
        class="watch-player"
        videoId={video.id}
        title={video.title}
        durationLabel={video.durationLabel}
        mode="embed"
      />
      <p class="watch-player-meta">
        {video.durationLabel} · KM Wellness Center
        <a href={video.youtubeUrl} target="_blank" rel="noopener noreferrer">Watch on YouTube <span aria-hidden="true">↗</span></a>
      </p>
    </div>

    <section class="watch-details">
      <div class="watch-details__copy">
        <p class="eyebrow">{detailEyebrow}</p>
        <h2>{detailTitle}</h2>
        <p>{detailBody}</p>
        <a class="text-link" href={servicePath}>Explore {serviceName}</a>
      </div>

      <aside class="watch-cta" aria-labelledby={`watch-cta-${video.id}`}>
        <p class="eyebrow">Your next step</p>
        <h2 id={`watch-cta-${video.id}`}>{ctaTitle}</h2>
        <p>{ctaBody}</p>
        <a class="button button-light" href="/contact-us/">Book a consultation</a>
      </aside>
    </section>
  </div>
</BaseLayout>

<style>
  .watch-page {
    display: grid;
    gap: clamp(0.85rem, 1.8vw, 1.1rem);
  }

  .watch-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.58fr);
    align-items: end;
    gap: clamp(1.5rem, 5vw, 4.5rem);
    padding: clamp(1.25rem, 3vw, 2.25rem) clamp(0.25rem, 2vw, 1.25rem);
  }

  .watch-intro h1 {
    max-width: 840px;
    font-size: clamp(3rem, 6vw, 5.6rem);
  }

  .watch-intro > p {
    max-width: 34rem;
    margin: 0 0 0.35rem;
    font-size: clamp(1rem, 1.3vw, 1.12rem);
  }

  .watch-player-shell {
    padding: clamp(0.55rem, 1.6vw, 1rem);
    border: 1px solid rgb(255 255 255 / 12%);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 90% 0%, rgb(255 255 255 / 12%), transparent 20rem),
      #050505;
    box-shadow: 0 24px 64px rgb(0 0 0 / 24%);
  }

  .watch-player-shell :global(.watch-player) {
    border-radius: 14px;
    box-shadow: none;
  }

  .watch-player-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0;
    padding: 0.8rem 0.5rem 0.15rem;
    color: rgb(255 255 255 / 62%);
    font-size: 0.67rem;
    font-weight: 850;
    letter-spacing: 0.09em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .watch-player-meta a {
    color: var(--white);
    text-decoration: none;
  }

  .watch-player-meta a:hover,
  .watch-player-meta a:focus-visible {
    text-decoration: underline;
  }

  .watch-details {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
    gap: clamp(0.85rem, 1.8vw, 1.1rem);
  }

  .watch-details__copy,
  .watch-cta {
    padding: clamp(1.65rem, 4vw, 3rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: 0 16px 44px rgb(0 0 0 / 8%);
  }

  .watch-details__copy {
    background: linear-gradient(135deg, var(--paper-soft), #ededed);
  }

  .watch-details h2 {
    margin-bottom: 1rem;
    font-size: clamp(2rem, 4vw, 3.5rem);
  }

  .watch-details__copy > p:not(.eyebrow) {
    max-width: 46rem;
  }

  .watch-details__copy .text-link {
    margin-top: 0.35rem;
  }

  .watch-cta {
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-color: rgb(255 255 255 / 10%);
    background:
      radial-gradient(circle at 100% 0%, rgb(255 255 255 / 12%), transparent 15rem),
      #111;
    color: var(--white);
  }

  .watch-cta :is(h2, .eyebrow) {
    color: var(--white);
  }

  .watch-cta > p:not(.eyebrow) {
    color: rgb(255 255 255 / 72%);
  }

  .watch-cta .button {
    align-self: flex-start;
    margin-top: 0.35rem;
  }

  @media (max-width: 820px) {
    .watch-intro,
    .watch-details {
      grid-template-columns: 1fr;
    }

    .watch-intro {
      align-items: start;
      gap: 1rem;
    }
  }

  @media (max-width: 520px) {
    .watch-intro {
      padding-inline: 0;
    }

    .watch-player-meta {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.35rem;
    }
  }
</style>
